# Local development only. Copy to .env and edit if a port clashes.
#
#   cp .env.example .env
#
# Nothing below is a secret — it points at a throwaway container that holds no
# real data. Anything that IS a secret has no default and must be set.

POSTGRES_DB=spotter
POSTGRES_USER=spotter
POSTGRES_PASSWORD=spotter
# 5432, 5433 and 5434 are already claimed by other projects on this machine
# (pladum-legacy, pladum, aiwyn). 5435 keeps Spotter out of their way.
POSTGRES_PORT=5435

# Required by api/. No default on purpose — generate one:
#   openssl rand -base64 48
SPOTTER_JWT_SECRET=
